# Copy to .env. Defaults run fully offline with the scripted policy model.
AGENT_APP_ENV=development
AGENT_LOG_LEVEL=INFO
AGENT_DATABASE_PATH=data/shop.db
AGENT_SEED_ON_STARTUP=true
AGENT_CORS_ORIGINS=["http://localhost:5173"]

# Model: fake (offline scripted policy model) | anthropic | openai (any OpenAI-compatible server)
AGENT_LLM_PROVIDER=fake
AGENT_LLM_MODEL=
AGENT_LLM_BASE_URL=
AGENT_LLM_API_KEY=
AGENT_LLM_TIMEOUT_SECONDS=30

# Loop limits
AGENT_MAX_STEPS=6
AGENT_MAX_TOOL_CALLS_PER_TURN=8
AGENT_MAX_MESSAGE_CHARS=2000
AGENT_SESSION_TTL_HOURS=24

# Refund policy (BDT)
AGENT_REFUND_WINDOW_DAYS=7
AGENT_REFUND_AUTO_APPROVE_LIMIT=5000

# Admin endpoints (/api/admin/*) require this in the X-Admin-Key header
AGENT_ADMIN_API_KEY=change-me-admin-key
