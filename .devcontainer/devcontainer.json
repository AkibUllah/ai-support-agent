{
  "name": "ai-support-agent",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.11-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/node:1": {
      "version": "18"
    }
  },
  "hostRequirements": {
    "cpus": 2,
    "memory": "4gb"
  },
  "forwardPorts": [8000],
  "portsAttributes": {
    "8000": {
      "label": "Chat UI (/) and API docs (/docs)",
      "onAutoForward": "notify"
    }
  },
  "postCreateCommand": "pip install -e \".[dev]\" && npm ci --prefix ui && npm run build --prefix ui",
  "postStartCommand": "nohup uvicorn support_agent.api.main:app --host 0.0.0.0 --port 8000 > /tmp/ai-support-agent.log 2>&1 &",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "charliermarsh.ruff",
        "dbaeumer.vscode-eslint"
      ]
    }
  }
}
